#!/usr/bin/env bash

# mirror-repair - Patch eligibility.plist for iPhone mirroring
# Version: 1.1.0
# Repository: https://github.com/jonasrombach/shell-tools

# Colors
RED="\033[0;31m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
BLUE="\033[1;34m"
MAGENTA="\033[1;35m"
NC="\033[0m"

input_file="/private/var/db/os_eligibility/eligibility.plist"
PLISTBUDDY="/usr/libexec/PlistBuddy"

# Dependency check
if [[ ! -x "$PLISTBUDDY" ]]; then
    echo -e "${RED}❌ Error:${NC} PlistBuddy not found at $PLISTBUDDY. This tool is required."
    echo -e "${YELLOW}💡 PlistBuddy is included with macOS. If missing, please check your system integrity.${NC}"
    exit 1
fi

if [[ ! -f "$input_file" ]]; then
    echo -e "${RED}❌ Error:${NC} Input file not found: $input_file"
    exit 1
fi

echo -e "${BLUE}🔍 Checking and patching eligibility.plist using PlistBuddy...${NC}"

# Helper to read a value
read_plist_value() {
    "$PLISTBUDDY" -c "Print $1" "$input_file" 2>/dev/null
}
# Helper to set a value
set_plist_value() {
    sudo "$PLISTBUDDY" -c "Set $1 $2" "$input_file"
}

# 1. Patch os_eligibility_answer_t
key1="OS_ELIGIBILITY_DOMAIN_IRON:os_eligibility_answer_t"
old1=$(read_plist_value "$key1")
if [[ "$old1" == "2" ]]; then
    echo -e "${YELLOW}📝 $key1:${NC}"
    echo -e "  ${RED}- $old1${NC}"
    echo -e "  ${GREEN}+ 4${NC}"
    set_plist_value "$key1" 4
    changed=1
else
    echo -e "${GREEN}✅ $key1 already set to $old1${NC}"
fi

# 2. Patch status:OS_ELIGIBILITY_INPUT_COUNTRY_BILLING
key2="OS_ELIGIBILITY_DOMAIN_IRON:status:OS_ELIGIBILITY_INPUT_COUNTRY_BILLING"
old2=$(read_plist_value "$key2")
if [[ "$old2" == "2" ]]; then
    echo -e "${YELLOW}📝 $key2:${NC}"
    echo -e "  ${RED}- $old2${NC}"
    echo -e "  ${GREEN}+ 3${NC}"
    set_plist_value "$key2" 3
    changed=1
else
    echo -e "${GREEN}✅ $key2 already set to $old2${NC}"
fi

# 3. Patch status:OS_ELIGIBILITY_INPUT_COUNTRY_LOCATION
key3="OS_ELIGIBILITY_DOMAIN_IRON:status:OS_ELIGIBILITY_INPUT_COUNTRY_LOCATION"
old3=$(read_plist_value "$key3")
if [[ "$old3" == "2" ]]; then
    echo -e "${YELLOW}📝 $key3:${NC}"
    echo -e "  ${RED}- $old3${NC}"
    echo -e "  ${GREEN}+ 3${NC}"
    set_plist_value "$key3" 3
    changed=1
else
    echo -e "${GREEN}✅ $key3 already set to $old3${NC}"
fi

if [[ "$changed" == "1" ]]; then
    echo -e "${GREEN}🎉 Success:${NC} Patched $input_file"
else
    echo -e "${GREEN}✅ No changes needed. Already patched!${NC}"
fi

echo -e "${BLUE}📱 Launching iPhone Mirroring...${NC}"
open -a "iPhone Mirroring"
if [[ $? -eq 0 ]]; then
    echo -e "${GREEN}✅ iPhone Mirroring launched!${NC}"
else
    echo -e "${YELLOW}⚠️  Could not launch iPhone Mirroring app. Please open it manually from Applications or Spotlight.${NC}"
fi
